<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.proyecto_panaderia_jdbc1.EditarPerfilController"
      prefWidth="750.0" prefHeight="580.0"
      style="-fx-background-color: #f5e6d3;">

    <!-- Contenedor principal amarillo -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: #f4c430; -fx-padding: 20 28 16 28;" spacing="14.0">

        <!-- Fila: título + botón desactivar -->
        <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3a2a1a;"
                   text="Editar Perfil"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleDesactivarCuenta"
                    style="-fx-background-color: #e05a8a; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-padding: 7 16; -fx-cursor: hand;"
                    text="Desactivar cuenta"/>
        </HBox>

        <!-- Avatar -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <VBox alignment="CENTER"
                  style="-fx-background-color: #c8a882; -fx-background-radius: 50;
                         -fx-padding: 12;" prefWidth="60.0" prefHeight="60.0">
                <Label style="-fx-font-size: 28px;" text="👤"/>
            </VBox>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                   text="Datos personales"/>
        </HBox>

        <!-- Formulario en dos columnas -->
        <GridPane hgap="20.0" vgap="10.0">

            <!-- Columna izquierda -->

            <!-- Nombre completo -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Nombre completo"/>
                <TextField fx:id="txtNombreCompleto" prefWidth="320.0"
                           style="-fx-background-color: white; -fx-background-radius: 6;
                                  -fx-padding: 7; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Fecha de nacimiento (columna derecha) -->
            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Fecha de nacimiento"/>
                <DatePicker fx:id="dateFechaNacimiento" prefWidth="320.0"
                            style="-fx-background-color: white; -fx-background-radius: 6;
                                   -fx-font-size: 12px;"/>
            </VBox>

            <!-- Edad -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Edad"/>
                <TextField fx:id="txtEdad" prefWidth="320.0"
                           style="-fx-background-color: white; -fx-background-radius: 6;
                                  -fx-padding: 7; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Domicilio: Calle y Número (columna derecha) -->
            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Domicilio"/>
                <HBox spacing="8.0">
                    <TextField fx:id="txtCalle" promptText="Calle"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-padding: 7; -fx-font-size: 12px;"
                               HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtNumero" promptText="Número" prefWidth="90.0"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-padding: 7; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- Número de teléfono -->
            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Número de teléfono"/>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <TextField fx:id="txtTelefonoCasa" promptText="Casa" prefWidth="250.0"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-padding: 7; -fx-font-size: 12px;"/>
                    <ToggleButton fx:id="tglCasa"
                                  style="-fx-background-color: #3a2a1a; -fx-background-radius: 20;
                                         -fx-min-width: 44; -fx-min-height: 22; -fx-cursor: hand;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <TextField fx:id="txtTelefonoTrabajo" promptText="Trabajo" prefWidth="250.0"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-padding: 7; -fx-font-size: 12px;"/>
                    <ToggleButton fx:id="tglTrabajo"
                                  style="-fx-background-color: #3a2a1a; -fx-background-radius: 20;
                                         -fx-min-width: 44; -fx-min-height: 22; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Colonia (columna derecha) -->
            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Colonia"/>
                <TextField fx:id="txtColonia" prefWidth="320.0"
                           style="-fx-background-color: white; -fx-background-radius: 6;
                                  -fx-padding: 7; -fx-font-size: 12px;"/>

                <!-- Contraseña -->
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;
                              -fx-padding: 6 0 0 0;" text="Contraseña"/>
                <PasswordField fx:id="txtContrasena"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-padding: 7; -fx-font-size: 12px;" prefWidth="320.0"/>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <CheckBox fx:id="chkMostrarContrasena" onAction="#handleMostrarContrasena"/>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a;"
                           text="Mostrar contraseña"/>
                </HBox>
            </VBox>

        </GridPane>

        <!-- Botón añadir teléfono -->
        <Button onAction="#handleAnadirTelefono"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 7 18; -fx-cursor: hand;"
                text="+ Añadir teléfono"/>

    </VBox>

    <!-- Barra inferior: Regresar + Confirmar cambios -->
    <HBox alignment="CENTER" spacing="16.0"
          style="-fx-background-color: #f4c430; -fx-padding: 10 28 16 28;">
        <Button onAction="#handleRegresar"
                style="-fx-background-color: #6b5644; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 9 30; -fx-cursor: hand;"
                text="Regresar"/>
        <Button onAction="#handleConfirmarCambios"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 10 40; -fx-cursor: hand;"
                text="Confirmar cambios"/>
    </HBox>

</VBox>
