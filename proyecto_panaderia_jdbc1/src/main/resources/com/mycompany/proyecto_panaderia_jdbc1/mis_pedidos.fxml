<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.proyecto_panaderia_jdbc1.MisPedidosController"
      prefWidth="750.0" prefHeight="580.0"
      style="-fx-background-color: #f5e6d3;">

    <!-- Contenedor principal amarillo -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: #f4c430; -fx-background-radius: 0;
                 -fx-padding: 22 24 16 24;" spacing="16.0">

        <!-- Título -->
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3a2a1a;"
               text="Mis Pedidos"/>

        <!-- Barra de filtros -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: white; -fx-background-radius: 8;
                         -fx-padding: 6 12;">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Tipo de pedido:"/>
                <ComboBox fx:id="cmbTipoPedido" prefWidth="100.0"
                          style="-fx-background-color: transparent; -fx-font-size: 12px;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: white; -fx-background-radius: 8;
                         -fx-padding: 6 12;">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #4a3a2a; -fx-font-weight: bold;"
                       text="Rango de fechas"/>
                <Label style="-fx-font-size: 14px;" text="📅"/>
            </HBox>
            <Button onAction="#handleAplicarFiltros"
                    style="-fx-background-color: #e87722; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 16; -fx-cursor: hand;"
                    text="Aplicar Filtros"/>
        </HBox>

        <!-- Lista de pedidos en ScrollPane -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent;">
            <GridPane fx:id="gridPedidos" hgap="14.0" vgap="14.0"
                      style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="4.0" left="2.0" right="2.0" bottom="4.0"/>
                </padding>
            </GridPane>
        </ScrollPane>

    </VBox>

    <!-- Barra inferior con botón Regresar -->
    <HBox alignment="CENTER" style="-fx-background-color: #f4c430; -fx-padding: 12 24 14 24;">
        <Button onAction="#handleRegresar"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 9 30; -fx-cursor: hand;"
                text="Regresar"/>
    </HBox>

</VBox>
