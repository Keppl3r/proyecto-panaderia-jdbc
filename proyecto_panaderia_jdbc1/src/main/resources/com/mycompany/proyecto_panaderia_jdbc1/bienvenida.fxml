<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.proyecto_panaderia_jdbc1.BienvenidaController"
      prefWidth="750.0" prefHeight="550.0"
      style="-fx-background-color: #f5e6d3;">

    <!-- Barra superior -->
    <HBox alignment="CENTER_LEFT" spacing="10.0"
          style="-fx-background-color: #fdf5e6; -fx-padding: 10 20 10 20;
                 -fx-border-color: #e0d0b0; -fx-border-width: 0 0 1 0;">
        <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true">
            <image>
                <Image url="@logo_2.png"/>
            </image>
        </ImageView>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#handleCarrito"
                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 20px; -fx-padding: 4 8;">
            <graphic>
                <Label text="🛒" style="-fx-font-size: 22px;"/>
            </graphic>
        </Button>
        <Button onAction="#handlePerfil"
                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 20px; -fx-padding: 4 8;">
            <graphic>
                <Label text="👤" style="-fx-font-size: 22px;"/>
            </graphic>
        </Button>
        <Button onAction="#handleCerrarSesion"
                style="-fx-background-color: #e05a5a; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-padding: 6 14; -fx-cursor: hand;">
            <graphic>
                <Label text="⏻" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Área principal -->
    <VBox alignment="CENTER" spacing="35.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/>
        </padding>

        <!-- Saludo -->
        <VBox alignment="CENTER" spacing="6.0">
            <HBox alignment="CENTER" spacing="0.0">
                <Label style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #3a2a1a;" text="¡Hola, "/>
                <Label fx:id="lblNombreUsuario"
                       style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" text="Juan"/>
                <Label style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #3a2a1a;" text="!"/>
            </HBox>
            <Label style="-fx-font-size: 18px; -fx-text-fill: #6b5644;" text="Bienvenido"/>
        </VBox>

        <!-- Tarjetas de opciones -->
        <HBox alignment="CENTER" spacing="22.0">

            <!-- Tarjeta Ver Catálogo (amarillo) -->
            <VBox alignment="CENTER" spacing="12.0" prefWidth="195.0" prefHeight="205.0"
                  style="-fx-background-color: #f4c430; -fx-background-radius: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);
                         -fx-padding: 18;">
                <ImageView fitHeight="58.0" fitWidth="78.0" preserveRatio="true">
                    <image>
                        <Image url="@pan.png"/>
                    </image>
                </ImageView>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3a2a1a;"
                       text="Ver Catálogo"/>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #4a3a2a; -fx-text-alignment: center;"
                       text="Explora nuestros productos disponibles" wrapText="true"/>
                <Button onAction="#handleVerCatalogo" prefWidth="145.0" prefHeight="34.0"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand;"
                        text="Ver Productos"/>
            </VBox>

            <!-- Tarjeta Mis Pedidos (marrón oscuro) -->
            <VBox alignment="CENTER" spacing="12.0" prefWidth="195.0" prefHeight="205.0"
                  style="-fx-background-color: #3d2817; -fx-background-radius: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0, 0, 4);
                         -fx-padding: 18;">
                <Label style="-fx-font-size: 42px;" text="📦"/>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Mis Pedidos"/>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #c8b898; -fx-text-alignment: center;"
                       text="Consulta el estado de tus pedidos" wrapText="true"/>
                <Button onAction="#handleMisPedidos" prefWidth="145.0" prefHeight="34.0"
                        style="-fx-background-color: #f4c430; -fx-text-fill: #3a2a1a;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand;"
                        text="Ver Pedidos"/>
            </VBox>

            <!-- Tarjeta Mi Perfil (naranja) -->
            <VBox alignment="CENTER" spacing="12.0" prefWidth="195.0" prefHeight="205.0"
                  style="-fx-background-color: #e87722; -fx-background-radius: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0, 0, 4);
                         -fx-padding: 18;">
                <Label style="-fx-font-size: 42px;" text="👤"/>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Mi Perfil"/>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #fde8cc; -fx-text-alignment: center;"
                       text="Actualiza tu información personal" wrapText="true"/>
                <Button onAction="#handleMiPerfil" prefWidth="145.0" prefHeight="34.0"
                        style="-fx-background-color: #f4c430; -fx-text-fill: #3a2a1a;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand;"
                        text="Editar Perfil"/>
            </VBox>

        </HBox>
    </VBox>

</VBox>
